<!-- Gallery Preview -->
<section class="gallery-preview section-padding">
  <div class="container">
    <div class="section-header center">
      <span class="section-eyebrow">Our Gallery</span>
      <h2 class="section-title">A Glimpse of Our Work</h2>
      <p class="section-subtitle">Real people. Real results. See how we help create every day.</p>
    </div>

    <div class="gallery-grid">
      <div class="gallery-item">
        <img src="/images/gallery-1.jpg" alt="Hair styling transformation Kansas City" loading="lazy" width="400" height="500">
        <div class="gallery-overlay"><span>Hair Styling</span></div>
      </div>
      <div class="gallery-item">
        <img src="/images/gallery-2.jpg" alt="Facial treatment results" loading="lazy" width="400" height="500">
        <div class="gallery-overlay"><span>Facials</span></div>
      </div>
      <div class="gallery-item">
        <img src="/images/gallery-3.jpg" alt="Nail art design" loading="lazy" width="400" height="500">
        <div class="gallery-overlay"><span>Nail Art</span></div>
      </div>
      <div class="gallery-item">
        <img src="/images/gallery-4.jpg" alt="Professional makeup" loading="lazy" width="400" height="500">
        <div class="gallery-overlay"><span>Makeup</span></div>
      </div>
    </div>

    <div class="text-center mt-4">
      <a href="/gallery" class="btn btn-outline">View More Photos <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>

<!-- Reviews Preview — Carousel -->
<section class="reviews-preview section-padding" id="testimonials">
  <div class="container">
    <div class="section-header center">
      <span class="section-eyebrow">Our Testimonials</span>
      <h2 class="section-title">What Our Clients Say</h2>
      <p class="section-subtitle">Real stories from real people who love BelleAura.</p>
    </div>

    <div class="testimonial-carousel" data-carousel>
      <div class="carousel-stage">
        <button class="carousel-arrow carousel-arrow--prev" type="button" data-carousel-prev aria-label="Show previous testimonials">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        <div class="testimonial-viewport" data-carousel-track tabindex="0" role="region" aria-label="Client testimonials carousel">
          <% reviews.forEach(function(review) { %>
            <article class="review-card testimonial-card">
              <div class="review-stars" aria-label="<%= review.rating %> out of 5 stars">
                <% for (let i = 0; i < review.rating; i++) { %>
                  <span class="star" aria-hidden="true">&starf;</span>
                <% } %>
              </div>
              <p class="review-text"><%= review.text %></p>
              <div class="review-author">
                <strong><%= review.name %></strong>
                <span><%= review.location %> &bull; <%= review.service %></span>
              </div>
            </article>
          <% }); %>
        </div>

        <button class="carousel-arrow carousel-arrow--next" type="button" data-carousel-next aria-label="Show next testimonials">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div class="carousel-dots" data-carousel-dots></div>
    </div>

    <div class="text-center mt-4">
      <a href="/reviews" class="btn btn-outline">Read All Reviews <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>