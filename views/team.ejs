<!-- Page Hero -->
<section class="page-hero">
  <div class="container">
    <span class="hero-eyebrow">Our Experts</span>
    <h1 class="page-title">Meet the Team</h1>
    <p class="page-subtitle">The talented artists behind every BelleAura transformation</p>
  </div>
</section>

<!-- Team Grid -->
<section class="team-section section-padding">
  <div class="container">
    <div class="section-header center">
      <span class="section-eyebrow">Beauty Professionals</span>
      <h2 class="section-title">Our Expert Team</h2>
      <p class="section-subtitle">Each member of our team brings years of experience, ongoing education, and a passion for beauty to every service.</p>
    </div>

    <div class="team-grid-large">
      <% team.forEach(function(member) { %>
        <div class="team-card-large">
          <div class="team-image-large">
            <img src="<%= member.image %>" alt="<%= member.name %>" loading="lazy" width="400" height="500">
          </div>
          <div class="team-info">
            <h3 class="team-name"><%= member.name %></h3>
            <span class="team-role"><%= member.role %></span>
            <p class="team-specialty"><strong>Specialty:</strong> <%= member.specialty %></p>
            <p class="team-bio">With years of professional experience and continuous training in the latest techniques and trends, <%= member.name %> is dedicated to helping every client look and feel their absolute best.</p>
            <a href="/book" class="btn btn-outline btn-sm">Book with <%= member.name.split(' ')[0] %></a>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Join Team CTA -->
    <div class="join-team-cta">
      <div class="join-team-content">
        <h3>Join Our Team</h3>
        <p>Are you a passionate beauty professional looking to grow your career in a supportive, inspiring environment?</p>
        <a href="mailto:careers@belleaura.com" class="btn btn-primary">View Career Opportunities <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>