<!-- CTA Section -->
<section class="cta-section">
  <div class="container">
    <div class="cta-inner">
      <div class="cta-content">
        <span class="cta-eyebrow">Ready to Feel Beautiful?</span>
        <h2 class="cta-title">Book Your Appointment Today</h2>
        <p class="cta-text">Your next glow-up is just a click away with us.</p>
        <a href="/book" class="btn btn-primary">Book Now <span aria-hidden="true">→</span></a>
      </div>
      <div class="cta-decor">
        <div class="decor-element">Be You</div>
        <svg class="decor-heart" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
      </div>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <img src="/images/logo-light.png" alt="BelleAura Beauty Salon" class="logo-img" width="199" height="48">
        </a>
        <p class="footer-tagline">Premium beauty salon in Kansas City dedicated to helping you look and feel your best.</p>
        <div class="footer-social">
          <a href="<%= site.social.facebook %>" aria-label="Facebook" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
          </a>
