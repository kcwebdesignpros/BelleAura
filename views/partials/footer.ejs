          </a>
          <a href="<%= site.social.pinterest %>" aria-label="Pinterest" target="_blank" rel="noopener">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0a12 12 0 00-4.37 23.17c-.09-.94-.18-2.39.04-3.42.2-.92 1.26-5.94 1.26-5.94s-.32-.65-.32-1.6c0-1.5.87-2.62 1.95-2.62.92 0 1.36.69 1.36 1.52 0 .93-.59 2.31-.89 3.59-.26 1.07.54 1.95 1.6 1.95 1.92 0 3.39-2.02 3.39-4.94 0-2.58-1.85-4.39-4.5-4.39a4.67 4.67 0 00-4.87 4.67c0 .92.36 1.92.8 2.45a.32.32 0 01.08.31l-.31 1.27c-.05.21-.16.25-.38.15-1.42-.66-2.31-2.74-2.31-4.41 0-3.59 2.61-6.89 7.51-6.89 3.95 0 7.01 2.81 7.01 6.57 0 3.92-2.47 7.08-5.9 7.08-1.15 0-2.24-.6-2.61-1.31l-.71 2.71c-.26.99-.96 2.24-1.42 3A12 12 0 1012 0z"/></svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h3>Quick Links</h3>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/gallery">Gallery</a></li>
          <li><a href="/reviews">Reviews</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/book">Book Now</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Our Services</h3>
        <ul>
          <% services.forEach(function(service) { %>
            <li><a href="/services/<%= service.slug %>"><%= service.name %></a></li>
          <% }); %>
        </ul>
      </div>

      <div class="footer-col">
        <h3>Contact Us</h3>
        <ul class="footer-contact">
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3z"/></svg>
            <span><%= site.address %></span>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.95-1.16v-3.79c0-.54-.31-.67-.95-.67z"/></svg>
            <a href="tel:+18165550123"><%= site.phone %></a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            <a href="mailto:<%= site.email %>"><%= site.email %></a>
          </li>
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            <span><%= site.hours %></span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; <%= new Date().getFullYear() %> BelleAura. All rights reserved.</p>
      <p><a href="/privacy-policy">Privacy Policy</a> • <a href="/terms">Terms & Conditions</a></p>
    </div>
  </div>
</footer>