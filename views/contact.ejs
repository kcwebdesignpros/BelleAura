<!-- Page Hero -->
<section class="page-hero">
  <div class="container">
    <span class="hero-eyebrow">Get in Touch</span>
    <h1 class="page-title">Contact BelleAura</h1>
    <p class="page-subtitle">We'd love to hear from you. Reach out for bookings, questions, or feedback.</p>
  </div>
</section>

<!-- Contact Section -->
<section class="contact-section section-padding">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-info">
        <h2 class="section-title">Visit Our Kansas City Salon</h2>
        <p>Conveniently located in the heart of Kansas City, Missouri. We're easy to find with plenty of free parking available for our clients.</p>

        <div class="contact-details">
          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3z"/></svg>
            </div>
            <div>
              <strong>Address</strong>
              <p>4820 JCT Country Club Road<br>Kansas City, MO 64112</p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.95-1.16v-3.79c0-.54-.31-.67-.95-.67z"/></svg>
            </div>
            <div>
              <strong>Phone</strong>
              <p><a href="tel:+18165550123">(816) 555-0123</a></p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            </div>
            <div>
              <strong>Email</strong>
              <p><a href="mailto:hello@belleaura.com">hello@belleaura.com</a></p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
            </div>
            <div>
              <strong>Business Hours</strong>
              <p>Mon-Sat: 9:00 AM - 8:00 PM<br>Sunday: 10:00 AM - 6:00 PM</p>
            </div>
          </div>
        </div>

        <div class="contact-cta">
          <a href="/book" class="btn btn-primary btn-large">Book Online <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="contact-form-wrapper">
        <h2 class="section-title">Send Us a Message</h2>
        <p>Have a question? We'll get back to you within 24 hours.</p>

        <form class="contact-form" action="/contact" method="POST" novalidate>
          <div class="form-row">
            <div class="form-group">
              <label for="name">Your Name *</label>
              <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
              <label for="phone">Phone Number</label>
              <input type="tel" id="phone" name="phone">
            </div>
          </div>

          <div class="form-group">
            <label for="email">Email Address *</label>
            <input type="email" id="email" name="email" required>
          </div>

          <div class="form-group">
            <label for="service">Service of Interest</label>
            <select id="service" name="service">
              <option value="">Select a service</option>
              <option value="hair-styling">Hair Styling</option>
              <option value="facials">Facials</option>
              <option value="nail-care">Nail Care</option>
              <option value="makeup">Makeup</option>
              <option value="spa-treatments">Spa Treatments</option>
              <option value="bridal-packages">Bridal Packages</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Your Message *</label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-large btn-block">Send Message</button>
          <p class="form-note">By submitting this form, you agree to our <a href="/privacy-policy">Privacy Policy</a>.</p>
        </form>
      </div>
    </div>

    <!-- Map Section -->
    <div class="contact-map">
      <h2 class="section-title center">Find Us in Kansas City</h2>
      <div class="map-placeholder">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3104.7!2d-94.5928!3d39.0067!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13%20!3m3!1m2!1s0x0%3A0x0!2zMznCsDAwJzI0LjEiTiA5NMKwMzUnMzUuOSJX!5e0!3m2!1sen!2sus!4v1234567890"
          width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="BelleAura Kansas City Location">
        </iframe>
      </div>
    </div>
  </div>
</section>