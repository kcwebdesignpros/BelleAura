<!-- Page Hero -->
<section class="page-hero">
  <div class="container">
    <span class="hero-eyebrow">Discover BelleAura</span>
    <h1 class="page-title">About BelleAura</h1>
    <p class="page-subtitle">Kansas City's premier destination for premium beauty services</p>
  </div>
</section>

<!-- Story Section -->
<section class="about-story section-padding">
  <div class="container">
    <div class="about-grid">
      <div class="about-image-wrap">
        <div class="about-image">
          <img src="/images/about-story.jpg" alt="BelleAura salon interior Kansas City" loading="lazy" width="600" height="700">
        </div>
        <div class="about-image-badge">
          <span class="about-image-badge-num">2019</span>
          <span class="about-image-badge-label">Established</span>
        </div>
      </div>
      <div class="about-content">
        <span class="section-eyebrow">Our Story</span>
        <h2 class="section-title">A Legacy of Beauty in Kansas City</h2>
        <p>Founded in 2019, BelleAura Beauty Salon has become Kansas City's most trusted destination for premium beauty services. Our journey began with a simple mission: to create a space where every person who walks through our doors feels valued, beautiful, and confident.</p>
        <p>What started as a small studio has grown into a full-service beauty destination, yet we've maintained our commitment to personalized care and attention to detail. Every service we offer, every product we use, and every member of our team reflects our dedication to the art of lasting beauty in Kansas City.</p>
        <a href="/services" class="btn btn-primary mt-3">Explore Our Services <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<!-- Mission Section -->
<section class="mission-section section-padding bg-cream-deep">
  <div class="container">
    <div class="section-header center">
      <span class="section-eyebrow">Our Philosophy</span>
      <h2 class="section-title">Beauty with Purpose</h2>
    </div>

    <div class="values-grid">
      <div class="value-card">
        <div class="value-icon">
          <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2"/><path d="M24 14v10l7 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <h3>Personalized Care</h3>
        <p>Every client is unique. We take time to understand your goals and customize each service to deliver results you'll love.</p>
      </div>

      <div class="value-card">
        <div class="value-icon">
          <svg viewBox="0 0 48 48" fill="none"><path d="M24 4L8 14v20l16 10 16-10V14L24 4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M24 24l8-5M24 24l-8-5M24 24v20" stroke="currentColor" stroke-width="2"/></svg>
        </div>
        <h3>Premium Quality</h3>
        <p>We use only the finest professional products from trusted brands, ensuring your beauty service in Kansas City delivers lasting, beautiful results.</p>
      </div>

      <div class="value-card">
        <div class="value-icon">
          <svg viewBox="0 0 48 48" fill="none"><path d="M24 8c-8 0-14 6-14 14 0 10 14 22 14 22s14-12 14-22c0-8-6-14-14-14z" stroke="currentColor" stroke-width="2"/><circle cx="24" cy="22" r="4" fill="currentColor"/></svg>
        </div>
        <h3>Local Beauty Roots</h3>
        <p>Proudly serving Kansas City and the surrounding communities with care, expertise, and a deep commitment to our neighbors.</p>
      </div>
    </div>
  </div>
</section>

<!-- Team Section -->
<section class="team-section section-padding">
  <div class="container">
    <div class="section-header center">
      <span class="section-eyebrow">Our Team</span>
      <h2 class="section-title">Meet Our Beauty Experts</h2>
      <p class="section-subtitle">Our talented team of certified beauty professionals brings passion, skill, and artistry to every service.</p>
    </div>

    <div class="team-grid">
      <% team.forEach(function(member) { %>
        <div class="team-card">
          <div class="team-image">
            <img src="<%= member.image %>" alt="<%= member.name %> - <%= member.role %> at BelleAura" loading="lazy" width="300" height="400">
          </div>
          <h3 class="team-name"><%= member.name %></h3>
          <span class="team-role"><%= member.role %></span>
          <p class="team-specialty">Specialty: <%= member.specialty %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<!-- Stats Section -->
<section class="stats-section">
  <div class="container">
    <div class="stats-intro">
      <span class="section-eyebrow light">Why Choose BelleAura</span>
      <h2 class="section-title light">Beauty. Care. Confidence.</h2>
      <p class="section-subtitle light">You're not just a visitor — we're your partner in care.</p>
    </div>
    <div class="stats-grid">
      <div class="stat-item">
        <span class="stat-number">5+</span>
        <span class="stat-label">Years of Experience</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">10K+</span>
        <span class="stat-label">Happy Clients</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">20+</span>
        <span class="stat-label">Beauty Experts</span>
      </div>
      <div class="stat-item">
        <span class="stat-number">100%</span>
        <span class="stat-label">Satisfaction Guarantee</span>
      </div>
    </div>
  </div>
</section>