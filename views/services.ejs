<!-- Page Hero -->
<section class="page-hero">
  <div class="container">
    <span class="hero-eyebrow">Our Services</span>
    <h1 class="page-title">Beauty Services We Offer</h1>
    <p class="page-subtitle">Premium beauty services designed to bring out your natural beauty</p>
  </div>
</section>

<!-- Services Grid -->
<section class="services-section section-padding">
  <div class="container">
    <div class="section-header center">
      <span class="section-eyebrow">Complete Care</span>
      <h2 class="section-title">Explore All Our Services</h2>
      <p class="section-subtitle">From hair to nails, skincare to makeup, our comprehensive beauty services cover every aspect of your self-care needs.</p>
    </div>

    <div class="services-grid services-grid-large">
      <% services.forEach(function(service) { %>
        <a href="/services/<%= service.slug %>" class="service-card service-card-large">
          <div class="service-icon">
            <% if (service.icon === 'cut') { %>
              <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="18" r="10" stroke="currentColor" stroke-width="2"/><path d="M8 38c4-8 12-12 16-12s12 4 16 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <% } else if (service.icon === 'face') { %>
              <svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="14" stroke="currentColor" stroke-width="2"/><circle cx="19" cy="22" r="1.5" fill="currentColor"/><circle cx="29" cy="22" r="1.5" fill="currentColor"/><path d="M20 30c2 2 6 2 8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <% } else if (service.icon === 'nail') { %>
              <svg viewBox="0 0 48 48" fill="none"><path d="M16 8c-4 0-8 4-8 8 0 8 8 24 16 24s16-16 16-24c0-4-4-8-8-8" stroke="currentColor" stroke-width="2"/><ellipse cx="24" cy="14" rx="6" ry="4" stroke="currentColor" stroke-width="2"/></svg>
            <% } else if (service.icon === 'makeup') { %>
              <svg viewBox="0 0 48 48" fill="none"><rect x="12" y="14" width="24" height="6" rx="3" stroke="currentColor" stroke-width="2"/><path d="M24 20v18" stroke="currentColor" stroke-width="2"/><path d="M18 38h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <% } else if (service.icon === 'spa') { %>
              <svg viewBox="0 0 48 48" fill="none"><path d="M24 8c-2 4-2 8 0 12M24 8c2 4 2 8 0 12M14 24c2-4 6-6 10-6s8 2 10 6c-4 8-10 12-14 12-6 0-10-4-14-12z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M14 40h20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <% } else if (service.icon === 'crown') { %>
              <svg viewBox="0 0 48 48" fill="none"><path d="M8 32l4-16 8 8 8-12 8 12 8-8 4 16H8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="16" r="2" fill="currentColor"/><circle cx="24" cy="12" r="2" fill="currentColor"/><circle cx="36" cy="16" r="2" fill="currentColor"/></svg>
            <% } %>
          </div>
          <h3 class="service-name"><%= service.name %></h3>
          <p class="service-desc"><%= service.shortDescription %></p>
          <span class="service-link">Learn More →</span>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- Why Choose Us -->
<section class="why-choose-section section-padding bg-cream-deep">
  <div class="container">
    <div class="section-header center">
      <span class="section-eyebrow">The BelleAura Difference</span>
      <h2 class="section-title">Why Kansas City Chooses Us</h2>
    </div>

    <div class="why-grid">
      <div class="why-item">
        <h3>Certified Professionals</h3>
        <p>Every team member is fully licensed, continuously trained, and passionate about delivering exceptional beauty services.</p>
      </div>
      <div class="why-item">
        <h3>Premium Products Only</h3>
        <p>We partner with the world's leading beauty brands to bring you products that are safe, effective, and luxurious.</p>
      </div>
      <div class="why-item">
        <h3>Hygiene & Cleanliness</h3>
        <p>We maintain the highest standards of cleanliness and sanitation. Your health and safety are always our priority.</p>
      </div>
      <div class="why-item">
        <h3>Welcoming Atmosphere</h3>
        <p>Step into our Kansas City salon and instantly feel at ease. We've designed every detail for your comfort and relaxation.</p>
      </div>
    </div>
  </div>
</section>