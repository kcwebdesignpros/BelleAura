<!-- Page Hero -->
<section class="page-hero">
  <div class="container">
    <span class="hero-eyebrow">Our Portfolio</span>
    <h1 class="page-title">Gallery</h1>
    <p class="page-subtitle">A showcase of our artistry and the beautiful results our clients love</p>
  </div>
</section>

<!-- Gallery Section -->
<section class="gallery-section section-padding">
  <div class="container">
    <div class="gallery-filters">
      <button class="filter-btn active" data-filter="all">All</button>
      <button class="filter-btn" data-filter="hair">Hair</button>
      <button class="filter-btn" data-filter="skin">Skin</button>
      <button class="filter-btn" data-filter="nails">Nails</button>
      <button class="filter-btn" data-filter="makeup">Makeup</button>
      <button class="filter-btn" data-filter="spa">Spa</button>
    </div>

    <div class="gallery-masonry">
      <div class="gallery-item tall" data-category="hair">
        <img src="/images/gallery-1.jpg" alt="Hair styling transformation" loading="lazy">
        <div class="gallery-overlay"><span>Hair Styling</span></div>
      </div>
      <div class="gallery-item" data-category="skin">
        <img src="/images/gallery-2.jpg" alt="Facial treatment results" loading="lazy">
        <div class="gallery-overlay"><span>Facial Treatment</span></div>
      </div>
      <div class="gallery-item" data-category="nails">
        <img src="/images/gallery-3.jpg" alt="Nail art design" loading="lazy">
        <div class="gallery-overlay"><span>Nail Art</span></div>
      </div>
      <div class="gallery-item tall" data-category="makeup">
        <img src="/images/gallery-4.jpg" alt="Professional makeup" loading="lazy">
        <div class="gallery-overlay"><span>Makeup</span></div>
      </div>
      <div class="gallery-item" data-category="hair">
        <img src="/images/gallery-5.jpg" alt="Hair coloring" loading="lazy">
        <div class="gallery-overlay"><span>Hair Color</span></div>
      </div>
      <div class="gallery-item" data-category="spa">
        <img src="/images/gallery-6.jpg" alt="Spa treatment" loading="lazy">
        <div class="gallery-overlay"><span>Spa Treatment</span></div>
      </div>
      <div class="gallery-item tall" data-category="nails">
        <img src="/images/gallery-7.jpg" alt="Manicure" loading="lazy">
        <div class="gallery-overlay"><span>Manicure</span></div>
      </div>
      <div class="gallery-item" data-category="skin">
        <img src="/images/gallery-8.jpg" alt="Skincare results" loading="lazy">
        <div class="gallery-overlay"><span>Skincare</span></div>
      </div>
    </div>
  </div>
</section>