# Environment Variables for BelleAura
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=production

# Site Configuration (used in app.js SITE_CONFIG)
SITE_URL=https://belleaura-salon.vercel.app
SITE_EMAIL=hello@belleaura.com
SITE_PHONE=(816) 555-0123
SITE_ADDRESS=4820 JCT Country Club Road, Kansas City, MO 64112

# Google Analytics (optional - replace with your GA4 ID)
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification (optional)
GOOGLE_SITE_VERIFICATION=your-verification-code

# Social Media URLs (optional)
INSTAGRAM_URL=https://instagram.com/belleaura
FACEBOOK_URL=https://facebook.com/belleaura
PINTEREST_URL=https://pinterest.com/belleaura